---
import AdminLayout from '../layouts/AdminLayout.astro';
import LoginForm from '../components/LoginForm.tsx';
---
<AdminLayout title="Iniciar sesión · EcoAmazónico Admin">
  <main class="relative min-h-screen flex items-center justify-center px-4 py-12 overflow-hidden bg-green-950">
    <!-- Decorative gradient background -->
    <div class="absolute inset-0 z-0">
      <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-eco-lime/10 blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-eco-lime/5 blur-3xl"></div>
      <div class="absolute inset-0 bg-gradient-to-br from-green-950 via-green-950 to-[#0a1a0a]"></div>
    </div>

    <div class="relative z-10 w-full max-w-md">
      <div class="text-center mb-8">
        <img
          src="/logo_ecoamazonico.png"
          alt="EcoAmazónico"
          class="h-16 w-auto object-contain mx-auto mb-4 brightness-0 invert"
        />
        <span class="bg-eco-lime text-green-950 px-3 py-1 rounded-sm text-xs font-bold uppercase tracking-wide inline-block mb-3">
          Panel de Administración
        </span>
        <h1 class="text-2xl md:text-3xl font-bold text-white" style="font-family: 'Poppins', sans-serif;">
          Bienvenido de nuevo
        </h1>
        <p class="text-gray-400 text-sm mt-2">
          Inicia sesión para gestionar el contenido de la landing
        </p>
      </div>

      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 md:p-8 shadow-2xl">
        <LoginForm client:only="react" />
      </div>

      <p class="text-center text-gray-500 text-xs mt-6">
        &copy; {new Date().getFullYear()} EcoAmazónico · Acceso restringido
      </p>
    </div>
  </main>
</AdminLayout>
