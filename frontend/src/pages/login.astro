---
import AdminLayout from '../layouts/AdminLayout.astro';
import LoginForm from '../components/LoginForm.tsx';
---
<AdminLayout title="Iniciar sesión · EcoAmazónico Admin">
  <main class="min-h-screen grid grid-cols-1 lg:grid-cols-5 bg-white">
    <!-- LEFT — Branding panel -->
    <aside class="hidden lg:flex lg:col-span-2 relative bg-black text-white flex-col justify-between p-12 xl:p-16 overflow-hidden">
      <!-- Subtle grid texture -->
      <div
        class="absolute inset-0 opacity-[0.06] pointer-events-none"
        style="background-image: linear-gradient(white 1px, transparent 1px), linear-gradient(90deg, white 1px, transparent 1px); background-size: 48px 48px;"
      ></div>

      <!-- Lime corner accent -->
      <div class="absolute top-0 left-0 h-1 w-32 bg-eco-lime"></div>

      <!-- Top: brand -->
      <div class="relative z-10 flex items-center gap-3">
        <img
          src="/logo_ecoamazonico.png"
          alt="EcoAmazónico"
          class="h-9 w-auto object-contain brightness-0 invert"
        />
        <div class="h-6 w-px bg-white/20"></div>
        <span class="text-[11px] uppercase tracking-[0.18em] text-gray-400 font-medium">
          Panel interno
        </span>
      </div>

      <!-- Middle: statement -->
      <div class="relative z-10 max-w-md">
        <h2
          class="text-4xl xl:text-5xl font-bold leading-[1.1] tracking-tight"
          style="font-family: 'Poppins', sans-serif;"
        >
          Gestiona el contenido<br />
          de tu landing con<br />
          <span class="relative inline-block">
            <span class="relative z-10">precisión</span>
            <span class="absolute left-0 right-0 bottom-1 h-3 bg-eco-lime/80 -z-0"></span>
          </span>.
        </h2>
        <p class="mt-6 text-gray-400 text-base leading-relaxed">
          Edita textos, reemplaza imágenes y publica cambios al instante, sin
          tocar una línea de código.
        </p>
      </div>

      <!-- Bottom: footer -->
      <div class="relative z-10 flex items-end justify-between text-[11px] uppercase tracking-[0.18em] text-gray-500">
        <span>&copy; {new Date().getFullYear()} EcoAmazónico Perú SRL</span>
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-eco-lime animate-pulse"></span>
          Acceso restringido
        </span>
      </div>
    </aside>

    <!-- RIGHT — Form panel -->
    <section class="lg:col-span-3 flex items-center justify-center px-6 py-12 lg:px-12">
      <div class="w-full max-w-sm">
        <!-- Mobile brand (only when aside is hidden) -->
        <div class="lg:hidden mb-10 flex items-center gap-3">
          <img
            src="/logo_ecoamazonico.png"
            alt="EcoAmazónico"
            class="h-8 w-auto object-contain"
          />
          <div class="h-5 w-px bg-gray-300"></div>
          <span class="text-[11px] uppercase tracking-[0.18em] text-gray-500 font-medium">
            Panel interno
          </span>
        </div>

        <div class="mb-10">
          <p class="text-[11px] uppercase tracking-[0.18em] text-gray-500 font-medium mb-3">
            Iniciar sesión
          </p>
          <h1
            class="text-3xl md:text-4xl font-bold text-black leading-tight tracking-tight"
            style="font-family: 'Poppins', sans-serif;"
          >
            Bienvenido<br />de nuevo.
          </h1>
        </div>

        <LoginForm client:only="react" />

        <p class="mt-10 text-xs text-gray-400">
          Solo cuentas autorizadas pueden ingresar. Si necesitas acceso,
          contacta al administrador del proyecto.
        </p>
      </div>
    </section>
  </main>
</AdminLayout>
