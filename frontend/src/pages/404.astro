---
import AdminLayout from '../layouts/AdminLayout.astro';
---
<AdminLayout title="Página no encontrada · EcoAmazónico Admin">
  <main class="min-h-screen grid grid-cols-1 lg:grid-cols-5 bg-white">
    <!-- LEFT — black panel -->
    <aside class="hidden lg:flex lg:col-span-2 relative bg-black text-white flex-col justify-between p-12 xl:p-16 overflow-hidden">
      <div
        class="absolute inset-0 opacity-[0.06] pointer-events-none"
        style="background-image: linear-gradient(white 1px, transparent 1px), linear-gradient(90deg, white 1px, transparent 1px); background-size: 48px 48px;"
      ></div>
      <div class="absolute top-0 left-0 h-1 w-32 bg-eco-lime"></div>

      <div class="relative z-10 flex items-center gap-3">
        <img
          src="/logo_ecoamazonico.png"
          alt="EcoAmazónico"
          class="h-9 w-auto object-contain brightness-0 invert"
        />
        <div class="h-6 w-px bg-white/20"></div>
        <span class="text-[11px] uppercase tracking-[0.18em] text-gray-400 font-medium">
          Panel interno
        </span>
      </div>

      <div class="relative z-10">
        <p
          class="text-[10rem] xl:text-[12rem] font-bold leading-none text-eco-lime tracking-tighter"
          style="font-family: 'Poppins', sans-serif;"
        >
          404
        </p>
      </div>

      <div class="relative z-10 text-[11px] uppercase tracking-[0.18em] text-gray-500">
        Ruta sin contenido
      </div>
    </aside>

    <!-- RIGHT — content -->
    <section class="lg:col-span-3 flex items-center justify-center px-6 py-12 lg:px-12">
      <div class="w-full max-w-sm">
        <div class="lg:hidden mb-10 flex items-center gap-3">
          <img
            src="/logo_ecoamazonico.png"
            alt="EcoAmazónico"
            class="h-8 w-auto object-contain"
          />
          <div class="h-5 w-px bg-gray-300"></div>
          <span class="text-[11px] uppercase tracking-[0.18em] text-gray-500 font-medium">
            Panel interno
          </span>
        </div>

        <p class="text-[11px] uppercase tracking-[0.18em] text-gray-500 font-medium mb-3">
          Error 404
        </p>
        <h1
          class="text-3xl md:text-4xl font-bold text-black leading-tight tracking-tight mb-4"
          style="font-family: 'Poppins', sans-serif;"
        >
          Esta página<br />no existe.
        </h1>
        <p class="text-gray-500 text-sm leading-relaxed mb-10">
          La ruta que intentaste abrir no corresponde a ninguna sección del
          panel. Es posible que el enlace esté roto o que la página haya sido
          movida.
        </p>

        <a
          href="/dashboard"
          class="group relative w-full bg-black text-white font-medium py-3.5 px-6 hover:bg-gray-900 transition-all duration-200 flex items-center justify-between gap-2 overflow-hidden"
        >
          <span class="absolute left-0 top-0 bottom-0 w-1 bg-eco-lime transition-all duration-200 group-hover:w-2"></span>
          <span class="pl-2 text-sm tracking-wide uppercase">
            Volver al dashboard
          </span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <p class="mt-10 text-xs text-gray-400">
          Si llegaste aquí desde un enlace dentro del panel, avisa al
          administrador del proyecto.
        </p>
      </div>
    </section>
  </main>
</AdminLayout>
