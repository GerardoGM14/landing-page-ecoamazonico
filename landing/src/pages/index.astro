    { title: 'Capacitaciones Especializadas', description: 'Manejo Integrado de Plagas, gestión del suelo, innovación y resiliencia climática de cultivos amazónicos y altoandinos, Buenas Prácticas Agrícolas, formación de facilitadores y promotores, otros.', icon: 'users' },
    { title: 'Proveeduría y Logística', description: 'Suministro de semillas, plantones, fertilizantes e insumos agropecuarios, venta de equipos, herramientas y materiales de construcción, alquiler de equipos de evaluación, monitoreo ambiental y movilidad y otros.', icon: 'briefcase' },
