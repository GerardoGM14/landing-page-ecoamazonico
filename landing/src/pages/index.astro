    { name: 'Oficina en Huánuco', address: 'Jr. Abancay 201, 2do piso Paucarbamba, Amarilis', mapEmbedUrl: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3930.567087807757!2d-76.2427849241639!3d-9.936353690165977!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91a7c2e25c04010b%3A0x62a129377478052a!2sJr.%20Abancay%20201%2C%20Hu%C3%A1nuco%2010001!5e0!3m2!1sen!2spe!4v1709920000000!5m2!1sen!2spe', primary: false },
    { name: 'Oficina en Junín', address: 'Dirección por confirmar', mapEmbedUrl: 'https://maps.google.com/maps?q=Junin+Peru&t=&z=9&ie=UTF8&iwloc=&output=embed', primary: false },
