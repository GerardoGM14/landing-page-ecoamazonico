  { id: 'alquileres', order: 5, title: 'Alquileres', shortDesc: 'Renta de vehículos y equipos especializados.', fullDesc: 'Servicio de alquiler de vehículos y equipos de monitoreo ambiental, garantizando herramientas de alta calidad para la ejecución de sus proyectos y operaciones de campo.', icon: 'key', imageUrl: `${SEED_BUCKET}/servicio_5.jpg`, detailImages: [`${SEED_BUCKET}/alquiler_1.jpg`, `${SEED_BUCKET}/alquiler_2.jpg`] },
