const porQueElegirnosFallback: PorQueElegirnosContent = {
  badge: '¿Por qué elegirnos?',
  titlePrefix: 'Soluciones integrales con',
  typewriterWords: ['responsabilidad ambiental', 'innovación sostenible', 'compromiso social', 'excelencia técnica', 'visión de futuro'],
  paragraph: 'ECO AMAZONICO PERU SRL. cuenta con un equipo multidisciplinario de expertos con especialidad técnica de universidades de prestigio con alto grado académico, con más de 20 años de experiencia en investigación, tecnología e innovación.',
  carouselImages: [`${SEED_BUCKET}/carousel_nosotros_1.jpg`, `${SEED_BUCKET}/carousel_nosotros_2.jpg`, `${SEED_BUCKET}/carousel_nosotros_3.jpg`, `${SEED_BUCKET}/carousel_nosotros_4.jpg`],
