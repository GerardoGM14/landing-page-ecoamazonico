import NosotrosSection from '../components/NosotrosSection.tsx';
import PorQueElegirnosSection from '../components/PorQueElegirnosSection.tsx';
import ExperienciaSection from '../components/ExperienciaSection.tsx';
import CertificacionesSection from '../components/CertificacionesSection.tsx';
import FooterContent from '../components/FooterContent.tsx';
import type { Service, HeroContent as HeroContentType, NosotrosContent, PorQueElegirnosContent, ExperienciaContent, CertificacionesContent, FooterContent as FooterContentType } from '../lib/types.ts';

