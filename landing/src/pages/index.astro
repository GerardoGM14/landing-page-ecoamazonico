  items: [
    { name: 'SENACE', logoUrl: `${SEED_BUCKET}/icon_senase.png`, description: 'Registro Nacional de Consultores Ambientales en el Servicio Nacional de Certificación Ambiental para las Inversiones Sostenibles (Registro N° 431-2019-AGR). Autorizada para la elaboración de estudios ambientales de los proyectos de inversión.' },
