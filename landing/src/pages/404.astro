---
import '../styles/global.css';
import '@fontsource/poppins/700.css';
import '@fontsource/inter/400.css';
import { Image } from 'astro:assets';
import logoImg from '../assets/logo_ecoamazonico.png';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>Página no encontrada · EcoAmazónico</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="bg-green-950 text-white font-sans antialiased">
    <main class="relative min-h-screen flex items-center justify-center px-4 py-12 overflow-hidden">
      <!-- Decorative -->
      <div class="absolute inset-0 z-0">
        <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-eco-lime/10 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 w-[28rem] h-[28rem] rounded-full bg-eco-lime/5 blur-3xl"></div>
      </div>

      <div class="relative z-10 max-w-xl w-full text-center">
        <div class="flex justify-center mb-10">
          <Image src={logoImg} alt="EcoAmazónico" class="h-14 w-auto object-contain brightness-0 invert" />
        </div>

        <p class="text-[11px] uppercase tracking-[0.25em] text-eco-lime font-semibold mb-6">
          Error 404
        </p>

        <h1
          class="text-[5rem] md:text-[7rem] font-bold leading-[0.9] tracking-tight mb-6"
          style="font-family: 'Poppins', sans-serif;"
        >
          Página no
          <span class="relative inline-block">
            <span class="relative z-10">encontrada</span>
            <span class="absolute left-0 right-0 bottom-2 md:bottom-3 h-3 md:h-5 bg-eco-lime/80 -z-0"></span>
          </span>.
        </h1>

        <p class="text-gray-300 text-base md:text-lg max-w-md mx-auto mb-10 leading-relaxed">
          La ruta que intentaste abrir no existe o fue movida. Vuelve al inicio
          y sigue explorando nuestros servicios.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
          <a
            href="/"
            class="bg-eco-lime text-green-950 px-8 py-3 rounded-full text-lg font-bold hover:bg-white hover:text-green-900 transition duration-300 flex items-center justify-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Ir al inicio
          </a>
          <a
            href="/#contacto"
            class="bg-transparent border-2 border-white text-white px-8 py-3 rounded-full text-lg font-bold hover:bg-white hover:text-green-950 transition duration-300 flex items-center justify-center gap-2 shadow-lg"
          >
            Contáctanos
          </a>
        </div>
      </div>

      <div class="absolute bottom-6 left-0 right-0 text-center text-gray-500 text-xs">
        &copy; {new Date().getFullYear()} EcoAmazónico Perú SRL
      </div>
    </main>
  </body>
</html>
